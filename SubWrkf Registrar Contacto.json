    {
      "parameters": {
        "jsCode": "// Mismo contrato que el resto de los Workers: { status, data, error }.\n\nconst d = $('Registrar Un Contacto').first().json;\n\nreturn [{ json: {\n  status: 'ok',\n  error: null,\n  data: {\n    duplicado: d.duplicado,\n    accion: d.duplicado ? 'actualizado' : 'insertado',\n    tabla: 'Contactos',\n    email: d.fila.email,\n    veces_visto: d.fila.veces_visto,\n    registrado_en: d.fila.registrado_en,\n    ultimo_contacto: d.fila.ultimo_contacto\n  }\n}}];"
      },
