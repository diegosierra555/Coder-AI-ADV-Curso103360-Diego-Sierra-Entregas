    {
      "parameters": {
        "jsCode": "// Compara lo que llego con lo que ya hay en la tabla y arma la fila final.\n// Si el email ya existe NO se inserta de nuevo: se actualiza el contador de contactos.\n\nconst origen = $('Start').first().json;\nconst contacto = origen.contacto ?? {};\nconst clas = origen.clasificacion ?? {};\nconst sc = origen.scoring ?? {};\nconst ahora = new Date().toISOString();\n\n// El nodo Data table corre con alwaysOutputData: si no hubo match llega un item vacio.\nconst encontrados = $input.all().filter(function (i) { return i.json && i.json.email; });\nconst previo = encontrados.length > 0 ? encontrados[0].json : null;\n\nconst fila = {\n  trace_id: String(origen.trace_id ?? ''),\n  email: String(contacto.email ?? ''),\n  nombre: String(contacto.nombreAlumno ?? ''),\n  familia: String(contacto.apellidoFamilia ?? ''),\n  intencion: String(clas.intencion ?? ''),\n  confianza: Number(clas.confianza ?? 0),\n  prioridad: String(clas.prioridad ?? ''),\n  score: Number(sc.score ?? 0),\n  temperatura: String(sc.temperatura ?? ''),\n  owner: String(sc.owner ?? ''),\n  sla_horas: Number(sc.sla_horas ?? 0),\n  // Si ya existia, se respeta la fecha de alta original.\n  registrado_en: previo ? String(previo.registrado_en ?? ahora) : ahora,\n  ultimo_contacto: ahora,\n  veces_visto: previo ? Number(previo.veces_visto ?? 1) + 1 : 1\n};\n\nreturn [{ json: {\n  duplicado: previo !== null,\n  row_id: previo ? (previo.id ?? null) : null,\n  fila: fila\n}}];"
      },
